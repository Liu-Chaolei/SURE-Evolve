{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sure.eval.model_publication_request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "model_id", "source_model_root", "target_registry_root", "artifact_sha256", "artifact_manifest_path", "artifact_manifest_sha256", "created_at", "automatic_publish_allowed"],
  "properties": {
    "schema": {"const": "sure.eval.model_publication_request.v1"},
    "status": {"const": "pending_human_review"},
    "model_id": {"type": "string", "minLength": 1},
    "source_model_root": {"type": "string", "minLength": 1},
    "target_registry_root": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_manifest_path": {"const": "publication_artifacts.json"},
    "artifact_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "automatic_publish_allowed": {"const": false}
  }
}
