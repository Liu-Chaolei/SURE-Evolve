{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sure.eval.result_index.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "publication", "model", "inference_runs", "evaluation_runs"],
  "properties": {
    "schema": {"const": "sure.eval.result_index.v2"},
    "publication": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending_human_review", "verified"]},
        "verified_by": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["id", "artifact_sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "inference_runs": {"type": "array", "items": {"$ref": "#/$defs/inferenceRun"}},
    "evaluation_runs": {"type": "array", "items": {"$ref": "#/$defs/evaluationRun"}}
  },
  "$defs": {
    "artifact": {
      "type": "object", "required": ["manifest_path", "manifest_sha256"],
      "properties": {"manifest_path": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "inferenceRun": {
      "type": "object", "required": ["id", "created_at", "protocol", "datasets"],
      "properties": {"id": {"type": "string"}, "created_at": {"type": "string"}, "protocol": {"type": "object"}, "datasets": {"type": "array", "minItems": 1}}
    },
    "evaluationRun": {
      "type": "object", "required": ["id", "created_at", "inference_id", "engine", "datasets"],
      "properties": {"id": {"type": "string"}, "created_at": {"type": "string"}, "inference_id": {"type": "string"}, "engine": {"type": "object"}, "datasets": {"type": "array", "minItems": 1}}
    }
  }
}
