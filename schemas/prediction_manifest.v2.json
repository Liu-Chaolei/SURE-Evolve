{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sure.eval.prediction_manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model", "dataset", "protocol", "sample_ids_sha256", "sample_count", "files"],
  "properties": {
    "schema": {"const": "sure.eval.prediction_manifest.v2"},
    "model": {"$ref": "#/$defs/model"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "sample_ids_sha256": {"$ref": "#/$defs/sha256"},
    "sample_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}},
    "model": {
      "type": "object", "additionalProperties": false, "required": ["id", "artifact_sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "split", "manifest_sha256", "sample_count"],
      "properties": {
        "id": {"type": "string", "pattern": "^[^/]+__[^/]+$"}, "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}, "split": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}, "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "effective_params_sha256"],
      "properties": {"id": {"enum": ["standard_system", "strict_core"]}, "version": {"type": "string", "minLength": 1}, "effective_params_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
