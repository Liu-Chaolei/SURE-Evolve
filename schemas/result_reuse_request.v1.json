{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sure.eval.result_reuse_request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "protocol", "datasets", "mode", "evaluation"],
  "properties": {
    "schema": {"const": "sure.eval.result_reuse_request.v1"},
    "model_id": {"type": "string", "minLength": 1},
    "protocol": {"type": "object", "required": ["id", "version", "effective_params_sha256"]},
    "datasets": {"type": "array", "minItems": 1},
    "mode": {"enum": ["auto", "reuse_result", "reevaluate", "retest"]},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_commit", "engine_tree_sha256", "pipeline_ids"],
      "properties": {
        "engine_commit": {"type": "string", "minLength": 1},
        "engine_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pipeline_ids": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
      }
    }
  }
}
