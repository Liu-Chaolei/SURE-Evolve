{
  "schema_version": "2",
  "name": "data_discover",
  "version": "1.0.0",
  "visibility": "internal",
  "description": "Rank declared public data and benchmark sources with transparent evidence.",
  "prompt": "SKILL.md",
  "runtime": {
    "kind": "python",
    "entrypoint": "scripts/discover.py",
    "lockfile": "requirements.lock",
    "executables": ["python"]
  },
  "permissions": {
    "tools": ["bash", "read", "write"],
    "network": true,
    "subprocess": true,
    "external_mutations": false
  },
  "output_schema": "schemas/source_plan.schema.json",
  "artifacts": [
    {
      "type": "data_source_plan",
      "schema_version": "1",
      "schema": "schemas/source_plan.schema.json",
      "required": true
    }
  ]
}
