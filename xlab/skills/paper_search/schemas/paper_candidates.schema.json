{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XLab Paper Candidates",
  "type": "object",
  "required": ["schema_version", "query", "generated_at", "providers", "errors", "candidates"],
  "properties": {
    "schema_version": { "const": "xlab.paper_candidates.v1" },
    "query": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "providers": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "authors", "provider", "source_rank", "dedupe_key"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "authors": { "type": "array", "items": { "type": "string" } },
          "year": { "type": ["integer", "null"] },
          "provider": { "type": "string" },
          "source_rank": { "type": "integer", "minimum": 1 },
          "dedupe_key": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
