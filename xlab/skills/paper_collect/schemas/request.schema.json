{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlab.local/schemas/paper_collection_request.schema.json",
  "title": "XLab Paper Collection Request",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Quoted topic parsed from the first invocation argument."
    },
    "invocation_arguments": {
      "type": ["string", "null"],
      "description": "Original slash-command arguments retained for provenance."
    },
    "facets": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "target_papers": { "type": "integer", "minimum": 1 },
    "max_papers": { "type": "integer", "minimum": 1 },
    "seed_limit": { "type": "integer", "minimum": 1 },
    "relation_limit_per_seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "min_graph_connected_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "download_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "download_per_host": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "additionalProperties": true
}
