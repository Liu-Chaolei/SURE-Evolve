{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SURE-Master package result",
  "type": "object",
  "required": ["schema_version", "status", "run_dir"],
  "properties": {
    "schema_version": {"const": "sure_master.result.v1"},
    "status": {"enum": ["success", "incomplete", "failed", "cancelled"]},
    "run_dir": {"type": "string", "minLength": 1},
    "returncode": {"type": ["integer", "null"]},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"}
  },
  "additionalProperties": true
}
