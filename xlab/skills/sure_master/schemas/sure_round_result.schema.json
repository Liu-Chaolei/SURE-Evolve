{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SURE-Master round result",
  "type": "object",
  "required": ["schema_version", "sure_run_id", "search_mode", "round_index", "baseline_digest", "idea_batch_digest", "result_digest", "candidates"],
  "properties": {
    "schema_version": {"const": "sure.round_result.v1"},
    "sure_run_id": {"type": "string", "minLength": 1},
    "search_mode": {"enum": ["ordinary", "staged_axes"]},
    "axis": {"enum": ["arch", "train", "inference", null]},
    "round_index": {"type": "integer", "minimum": 0},
    "baseline_digest": {"type": "string", "pattern": "^sha256:"},
    "idea_batch_digest": {"type": "string", "pattern": "^sha256:"},
    "result_digest": {"type": "string", "pattern": "^sha256:"},
    "candidates": {"type": "array"}
  },
  "additionalProperties": true
}
