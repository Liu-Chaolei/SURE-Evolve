{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SURE-Master idea request",
  "type": "object",
  "required": ["schema_version", "request_id", "sure_run_id", "task_id", "task_description", "search_mode", "round_index", "requested_idea_count", "metric", "input_digest"],
  "properties": {
    "schema_version": {"const": "sure.idea_request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "sure_run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_description": {"type": "string", "minLength": 1},
    "search_mode": {"enum": ["ordinary", "staged_axes"]},
    "axis": {"enum": ["arch", "train", "inference", null]},
    "round_index": {"type": "integer", "minimum": 0},
    "requested_idea_count": {"type": "integer", "minimum": 1},
    "metric": {"type": "object", "required": ["name", "direction"]},
    "input_digest": {"type": "string", "pattern": "^sha256:"},
    "generation_policy": {"type": "object", "properties": {
      "engine": {"const": "native"},
      "feedback_kind": {"const": "candidate_outcome"},
      "refinement": {"const": "current_best"},
      "allow_auxiliary_experiments": {"const": false},
      "memory_scope": {"type": "object"},
      "mcts": {"type": "object", "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 1},
        "branching_factor": {"type": "integer", "minimum": 1},
        "exploration_constant": {"type": "number", "minimum": 0}
      }, "additionalProperties": false}
    }}
  },
  "additionalProperties": true
}
