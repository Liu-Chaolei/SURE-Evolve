{
  "schema_version": "2",
  "name": "data_process",
  "version": "1.0.0",
  "visibility": "internal",
  "description": "Normalize collected CSV, JSON, and JSONL payloads through an explicit mapping contract.",
  "prompt": "SKILL.md",
  "runtime": {
    "kind": "python",
    "entrypoint": "scripts/process.py",
    "lockfile": "requirements.lock",
    "executables": ["python"]
  },
  "permissions": {
    "tools": ["bash", "read", "write"],
    "network": false,
    "subprocess": true,
    "external_mutations": false
  },
  "output_schema": "schemas/processing_report.schema.json",
  "artifacts": [
    {
      "type": "processed_dataset",
      "schema_version": "1",
      "schema": "schemas/processing_report.schema.json",
      "required": true
    }
  ]
}
