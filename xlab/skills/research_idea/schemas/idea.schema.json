{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlab.dev/schemas/research_idea/idea.v2.schema.json",
  "title": "Research idea artifact v2",
  "$defs": {
    "nonemptyString": { "type": "string", "minLength": 1 },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "algorithmProvenance": {
      "type": "object",
      "required": [
        "algorithm",
        "runtime_profile",
        "evidence_profile",
        "success_profile"
      ],
      "properties": {
        "algorithm": { "const": "xlab.research_idea.algorithm.v2" },
        "runtime_profile": { "const": "xlab.research_idea.runtime.v1" },
        "evidence_profile": { "const": "xlab.research_idea.evidence.v1" },
        "success_profile": { "const": "xlab.research_idea.success.v1" }
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "blockers",
    "completed_stages",
    "algorithm_provenance"
  ],
  "properties": {
    "schema_version": { "const": "xlab.research_idea.v2" },
    "status": { "enum": ["success", "incomplete"] },
    "incomplete_reason": { "type": "string", "minLength": 1 },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "completed_stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonemptyString" },
      "uniqueItems": true
    },
    "algorithm_provenance": { "$ref": "#/$defs/algorithmProvenance" },
    "run_id": { "type": "string" },
    "topic": { "type": "string" },
    "research_question": { "type": "string" },
    "hypothesis": { "type": "string" },
    "method": { "type": "string" },
    "expected_contribution": { "type": "string" },
    "experiment_plan": { "type": "array", "items": { "type": "string" } },
    "data_requirements": { "type": "array", "items": { "type": "string" } },
    "baselines": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "source_evidence": {
      "type": "array",
      "items": { "type": "object", "minProperties": 1 }
    },
    "idea_result": { "type": "object" },
    "source_context": { "type": "object" },
    "workflow_trace": { "type": "array" },
    "operation_trace": { "type": "array" },
    "mcts_evolution": { "type": "object" },
    "fusion_evolution": { "type": "object" },
    "fusion_metadata": { "type": "object" },
    "idea_contract": { "type": "object" },
    "replanning_trigger": {},
    "previous_results": {}
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "success" },
        "blockers": { "maxItems": 0 },
        "topic": { "$ref": "#/$defs/nonemptyString" },
        "research_question": { "$ref": "#/$defs/nonemptyString" },
        "hypothesis": { "$ref": "#/$defs/nonemptyString" },
        "method": { "$ref": "#/$defs/nonemptyString" },
        "expected_contribution": { "$ref": "#/$defs/nonemptyString" },
        "experiment_plan": { "$ref": "#/$defs/nonemptyStringArray" },
        "data_requirements": { "$ref": "#/$defs/nonemptyStringArray" },
        "baselines": { "$ref": "#/$defs/nonemptyStringArray" },
        "metrics": { "$ref": "#/$defs/nonemptyStringArray" },
        "risks": { "$ref": "#/$defs/nonemptyStringArray" },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "minProperties": 1 }
        },
        "idea_result": { "type": "object", "minProperties": 1 },
        "source_context": { "type": "object", "minProperties": 1 }
      },
      "required": [
        "topic",
        "research_question",
        "hypothesis",
        "method",
        "expected_contribution",
        "experiment_plan",
        "data_requirements",
        "baselines",
        "metrics",
        "risks",
        "source_evidence",
        "idea_result",
        "source_context"
      ]
    },
    {
      "properties": {
        "status": { "const": "incomplete" },
        "blockers": { "minItems": 1 }
      },
      "required": ["incomplete_reason"]
    }
  ],
  "additionalProperties": true
}
