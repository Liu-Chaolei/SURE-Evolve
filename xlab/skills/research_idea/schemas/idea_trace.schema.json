{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlab.dev/schemas/research_idea/idea_trace.v2.schema.json",
  "title": "Research idea trace artifact v2",
  "$defs": {
    "nonemptyString": { "type": "string", "minLength": 1 },
    "algorithmProvenance": {
      "type": "object",
      "required": [
        "algorithm",
        "runtime_profile",
        "evidence_profile",
        "success_profile"
      ],
      "properties": {
        "algorithm": { "const": "xlab.research_idea.algorithm.v2" },
        "runtime_profile": { "const": "xlab.research_idea.runtime.v1" },
        "evidence_profile": { "const": "xlab.research_idea.evidence.v1" },
        "success_profile": { "const": "xlab.research_idea.success.v1" }
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "blockers",
    "completed_stages",
    "algorithm_provenance"
  ],
  "properties": {
    "schema_version": { "const": "xlab.research_idea.trace.v2" },
    "status": { "enum": ["success", "incomplete"] },
    "incomplete_reason": { "type": "string", "minLength": 1 },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "completed_stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonemptyString" },
      "uniqueItems": true
    },
    "algorithm_provenance": { "$ref": "#/$defs/algorithmProvenance" },
    "run_id": { "type": "string" },
    "topic": { "type": "string" },
    "workflow_trace": { "type": "array" },
    "operation_trace": { "type": "array" },
    "source_context": { "type": "object" },
    "mcts_evolution": { "type": "object" },
    "fusion_evolution": { "type": "object" },
    "fusion_metadata": { "type": "object" },
    "workflow_namespaces": { "type": "array" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "success" },
        "blockers": { "maxItems": 0 },
        "run_id": { "$ref": "#/$defs/nonemptyString" },
        "topic": { "$ref": "#/$defs/nonemptyString" },
        "workflow_trace": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "minProperties": 1 }
        },
        "operation_trace": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "minProperties": 1 }
        },
        "source_context": { "type": "object", "minProperties": 1 },
        "mcts_evolution": { "type": "object", "minProperties": 1 }
      },
      "required": [
        "run_id",
        "topic",
        "workflow_trace",
        "operation_trace",
        "source_context",
        "mcts_evolution"
      ]
    },
    {
      "properties": {
        "status": { "const": "incomplete" },
        "blockers": { "minItems": 1 }
      },
      "required": ["incomplete_reason"]
    }
  ],
  "additionalProperties": true
}
