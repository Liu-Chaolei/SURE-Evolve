{
  "schema_version": "2",
  "name": "mcp_register",
  "version": "1.0.0",
  "visibility": "internal",
  "description": "Atomically register a validated MCP server with backup and rollback metadata.",
  "prompt": "SKILL.md",
  "runtime": {
    "kind": "python",
    "entrypoint": "scripts/register.py",
    "lockfile": "requirements.lock",
    "executables": ["python"]
  },
  "permissions": {
    "tools": ["bash", "read", "write"],
    "network": false,
    "subprocess": true,
    "external_mutations": true
  },
  "output_schema": "schemas/registration.schema.json",
  "artifacts": [
    {
      "type": "mcp_registration",
      "schema_version": "1",
      "schema": "schemas/registration.schema.json",
      "required": true
    }
  ]
}
