{
  "schema_version": "2",
  "name": "paper_parse",
  "version": "1.0.0",
  "visibility": "internal",
  "description": "Normalize Markdown, text, MinerU output, or available PDFs into reusable paper_document artifacts.",
  "prompt": "SKILL.md",
  "runtime": {
    "kind": "python",
    "entrypoint": "scripts/parse_documents.py",
    "lockfile": "requirements.lock",
    "executables": ["python"]
  },
  "permissions": {
    "tools": ["bash", "read", "write"],
    "network": false,
    "subprocess": true,
    "external_mutations": false
  },
  "input_schema": "schemas/fetch_manifest.schema.json",
  "output_schema": "schemas/paper_documents.schema.json",
  "hooks": {
    "pre_start": [{ "module": "hooks/index.ts", "handler": "preStart" }],
    "pre_finish": [{ "module": "hooks/index.ts", "handler": "preFinish" }]
  },
  "artifacts": [
    {
      "type": "paper_documents",
      "schema_version": "1",
      "schema": "schemas/paper_documents.schema.json",
      "required": true
    }
  ]
}
