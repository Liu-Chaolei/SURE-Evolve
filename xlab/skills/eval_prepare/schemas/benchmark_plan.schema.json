{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "model", "dataset", "task_type", "metrics", "seed", "created_at"],
  "properties": {
    "schema_version": { "const": "xlab.benchmark_plan.v1" },
    "model": { "type": "object", "required": ["identifier", "fingerprint"] },
    "dataset": { "type": "object", "required": ["path", "sha256", "case_count"] },
    "task_type": { "type": "string", "minLength": 1 },
    "metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "seed": { "type": "integer" },
    "baseline": { "type": ["string", "null"] },
    "created_at": { "type": "string" }
  }
}
