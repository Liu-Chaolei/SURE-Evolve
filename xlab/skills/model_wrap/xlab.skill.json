{
  "schema_version": "2",
  "name": "model_wrap",
  "version": "1.0.0",
  "visibility": "internal",
  "description": "Generate a self-contained stdio MCP server around an explicit local model command.",
  "prompt": "SKILL.md",
  "runtime": {
    "kind": "python",
    "entrypoint": "scripts/generate.py",
    "lockfile": "requirements.lock",
    "executables": ["python"]
  },
  "permissions": {
    "tools": ["bash", "read", "write"],
    "network": false,
    "subprocess": true,
    "external_mutations": false
  },
  "output_schema": "schemas/mcp_package.schema.json",
  "artifacts": [
    {
      "type": "mcp_package",
      "schema_version": "1",
      "schema": "schemas/mcp_package.schema.json",
      "required": true
    }
  ]
}
