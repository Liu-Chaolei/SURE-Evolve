{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlab.local/schemas/citation_trace.schema.json",
  "title": "XLab Literature Survey Citation Trace",
  "type": "object",
  "required": ["schema_version", "run_id", "references", "traces"],
  "properties": {
    "schema_version": { "const": "xlab.citation_trace.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paper_id", "title"],
        "properties": {
          "paper_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "year": { "type": ["integer", "null"] },
          "venue": { "type": ["string", "null"] },
          "authors": { "type": "array", "items": { "type": "string" } },
          "url": { "type": ["string", "null"] },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "paper_ids"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "paper_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
