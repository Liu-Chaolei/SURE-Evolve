# EvoMaster Environment Variables Example
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# ============================================
# OpenAI LLM Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For A2S2D structured outputs (OpenAI Responses API)
OPENAI_ENDPOINT=https://api.openai.com/v1/responses

# ============================================
# Anthropic LLM Configuration (optional)
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================
# DeepSeek LLM Configuration (optional)
# ============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# Kimi (Moonshot) LLM Configuration (optional)
# ============================================
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# ============================================
# OpenAlex Literature Search (optional)
# ============================================
# For A2S2D Stage 8 literature search
OPENALEX_API_KEY=your_openalex_api_key_here
# Or use mailto parameter (free but rate-limited)
OPENALEX_MAILTO=your_email@example.com

# ============================================
# A2S2D Data Paths (optional)
# ============================================
# Override paths from config.yaml
# A2S2D_DATA_PATH=/path/to/CGSS2023.dta
# A2S2D_CODEBOOK_PATH=/path/to/CGSS2023编码表.xlsx

# ============================================
# MCP Server Configuration (optional)
# ============================================
# For MCP tools integration
# MCP_OPENAI_API_KEY=${OPENAI_API_KEY}
# MCP_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# ============================================
# Debug Settings (optional)
# ============================================
# EVOMASTER_DEBUG=false
# EVOMASTER_LOG_LEVEL=INFO