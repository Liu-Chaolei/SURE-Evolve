# Source a PRIVATE copy after filling interpreter/model paths. No credentials belong in git.
export SURE_EVOLVE_ROOT=/shared/chaolei.liu/SURE-Evolve
export SURE_EVAL_ROOT=/shared/chaolei.liu/sure-eval
export SURE_DEVICE=0
# Choose the matching task + CUDA/NPU environment for each invocation.
export SURE_WORKER_PYTHON=/path/to/task-environment/bin/python
export SURE_METRIC_PYTHON=/path/to/sure-metrics-cpu/bin/python
export SURE_AGENT_MODEL=your-model
export OPENAI_BASE_URL=https://your-endpoint/v1
# Export OPENAI_API_KEY privately.
export XLAB_ROOT=/shared/chaolei.liu/XLab
export XLAB_PYTHON=/path/to/xlab-environment/bin/python
export XLAB_SURE_SURVEY_PATH=/path/to/completed/task-specific/literature-survey
export SURE_F5_ROOT=/shared/chaolei.liu/TTS/F5-TTS
export SURE_F5_CHECKPOINT=$SURE_F5_ROOT/ckpts/F5-TTS/F5TTS_v1_Base/model_1250000.safetensors
export SURE_F5_VOCAB=$SURE_F5_ROOT/ckpts/F5-TTS/F5TTS_v1_Base/vocab.txt
export SURE_VOCODER_ROOT=/path/to/vocos-mel-24khz
export SURE_TTS_DATA=/shared/chaolei.liu/data/sure_premium
export SURE_DIARIZEN_ROOT=/shared/chaolei.liu/SD/DiariZen
export SURE_DIARIZEN_MODEL=$SURE_DIARIZEN_ROOT/checkpoints/diarizen-wavlm-large-s80-md-v2
# DiariZen's upstream embedding dispatch requires 'pyannote' in this path.
export SURE_SD_EMBEDDING=/path/to/pyannote/wespeaker-voxceleb-resnet34-LM/pytorch_model.bin
export SURE_SD_DATA=/shared/chaolei.liu/data/sure_ami
export SURE_ICEFALL_ROOT=/shared/chaolei.liu/ASR/icefall
export SURE_DATA_DIR=/shared/chaolei.liu/data/sure_tedlium3_1h

# Complete training split used by ordinary ASR evolution (not the 1h smoke preparation).
export SURE_FULL_DATA_DIR=/shared/chaolei.liu/data/sure_tedlium3_full
