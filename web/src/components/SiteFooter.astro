---
import XLabMark from "./XLabMark.astro";
import { navItems, REPOSITORY_URL } from "../data/site";
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div><a class="brand" href="/"><XLabMark class="brand-mark" /><span>XLab</span></a><p>A research-agent harness built on Pi.</p></div>
    <nav aria-label="Footer">{navItems.map((item) => <a href={item.href}>{item.label}</a>)}<a href={REPOSITORY_URL}>GitHub</a></nav>
    <p class="footer-note">MIT licensed. Local agent execution with external providers where configured.</p>
  </div>
</footer>
